<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <config>
      <add key="globalPackagesFolder" value="packages" />
    </config>
    <!-- Restore via the internal mseng feed (Codex-Deps) instead of api.nuget.org
         directly. The 1ES hosted pool enforces network isolation and blocks
         outbound calls to api.nuget.org (NU1301/403). Codex-Deps has nuget.org
         configured as an upstream source, so public packages still resolve. -->
    <packageSources>
      <clear />
      <add key="Codex-Deps" value="https://mseng.pkgs.visualstudio.com/_packaging/3d6afd65-87f4-45c0-a5c7-2e59a6a18713/nuget/v3/index.json" />
    </packageSources>
</configuration>